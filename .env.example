# ============================================
# TRINETRA PULSE - Environment Configuration
# ============================================
# Copy this file to .env and fill in values.
# Keep real secrets OUT of source control.

# --- Application ---
APP_NAME=trinetra-pulse
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# --- Frontend ---
# The web app reads NEXT_PUBLIC_USE_MOCK_API and NEXT_PUBLIC_API_BASE_URL
# (see apps/web/.env.example). Set these in apps/web, not here.
# NEXT_PUBLIC_USE_MOCK_API=true
# NEXT_PUBLIC_API_BASE_URL=/api/v2

# --- CORS (Python API) ---
# Deployed frontend origin for the FastAPI CORS middleware (never use "*").
FRONTEND_URL=http://localhost:3000
# Additional allowed origins (comma-separated), optional.
CORS_ORIGINS=

# --- Evidence payload storage ---
# Local directory for dev-only evidence blobs (metadata lives in PostgreSQL).
# Render service filesystems are ephemeral; use object storage in production.
EVIDENCE_STORAGE_DIR=.evidence
EVIDENCE_STORAGE_PROVIDER=filesystem
EVIDENCE_STORAGE_BUCKET=
EVIDENCE_STORAGE_REGION=
EVIDENCE_STORAGE_ENDPOINT=
EVIDENCE_STORAGE_ACCESS_KEY_ID=
EVIDENCE_STORAGE_SECRET_ACCESS_KEY=
EVIDENCE_STORAGE_PREFIX=evidence

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trinetra_pulse
POSTGRES_USER=trinetra
POSTGRES_PASSWORD=trinetra_dev_password

# --- Neo4j (infrastructure only; API is demo/in-memory) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password

# --- Redis (infrastructure only; API is demo/in-memory) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# --- JWT / Auth (Phase 18.1 — ACTIVE) ---
# JWT_SECRET_KEY is read by app/core/security.py. Production must use a strong,
# randomly generated 32+ char secret (Render's render.yaml provides
# JWT_SECRET_KEY) — the API refuses to trust its dev default in APP_ENV=production.
# Demo accounts (seeded only when DATABASE_URL is unset or empty):
#   investigator@trinetra.dev / Investigator!2026
#   supervisor@trinetra.dev   / Supervisor!2026
#   admin@trinetra.dev        / Admin!2026
#   auditor@trinetra.dev      / Auditor!2026   (read-only RBAC role)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- ML Services (dormant; not consumed by the current demo API) ---
ML_SERVICE_URL=http://localhost:8001

# --- AI Investigation Assistant ---
# "mock" (deterministic, offline demo) or "openai" (OpenAI-compatible).
# AI_API_KEY is server-side only; never expose it to the client.
AI_PROVIDER=mock
AI_MODEL=trinetra-deterministic-local-v0
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
