# ---------------------------------------------------------------------------
# Trinetra Pulse web app configuration
#
# These are Next.js client-side env vars (inlined at build time). Read by
# src/lib/api/config.ts.
# ---------------------------------------------------------------------------

# Data source switch (Phase 14.2 real application layer).
#   "true"  -> consume in-memory demo services (default; UI works with no backend)
#   "false" -> consume the real relational backend at /api/v2
#
#   LOCAL DEVELOPMENT   : NEXT_PUBLIC_USE_MOCK_API=true
#   PRODUCTION (Render) : NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_USE_MOCK_API=true

# Base URL of the relational API when NEXT_PUBLIC_USE_MOCK_API=false.
# With next dev / next start and the API proxied on the same origin, the
# default "/api/v2" is correct. For a separate-origin deployment (Render) set
# the API's absolute public URL, e.g. https://trinetra-pulse-api.onrender.com
#   LOCAL DEVELOPMENT   : NEXT_PUBLIC_API_BASE_URL=/api/v2
#   PRODUCTION (Render) : NEXT_PUBLIC_API_BASE_URL=https://<api-url>
#
# NOTE: NEXT_PUBLIC_* values are inlined at build time. Never put secrets
# (DATABASE_URL, API keys) in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_API_BASE_URL=/api/v2

# --- Sign in (Phase 18.1) -------------------------------------------------
# The web app has no token of its own: a user signs in and the JWT is held in
# sessionStorage/localStorage and attached as `Authorization: Bearer` by
# src/lib/api/client.ts. In API mode the login form calls /api/v2/auth/login.
# Demo accounts (seeded by the API) are shown on the login page in mock mode:
#   investigator@trinetra.dev / Investigator!2026
#   supervisor@trinetra.dev   / Supervisor!2026
#   admin@trinetra.dev        / Admin!2026
#   auditor@trinetra.dev      / Auditor!2026   (read-only RBAC role)
