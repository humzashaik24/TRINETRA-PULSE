# ---------------------------------------------------------------------------
# Trinetra Pulse API configuration
#
# Read via pydantic-settings from app/core/config.py (env_file = ".env").
# Copy this file to .env and adjust per environment.
# ---------------------------------------------------------------------------

APP_NAME=trinetra-pulse
# development | production (production refuses to boot while a default secret
# that the running configuration actually depends on is still set)
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# --- CORS (Phase 14.3) ---------------------------------------------------
# Production: FRONTEND_URL is the deployed Render frontend origin. CORS_ORIGINS
# may carry additional comma-separated origins. When both are empty the API
# allows localhost:3000/3001 for local development.
#
#   LOCAL:
#     FRONTEND_URL=http://localhost:3000
#   PRODUCTION:
#     FRONTEND_URL=https://<your-web-service>.onrender.com
FRONTEND_URL=
CORS_ORIGINS=

# --- Evidence payload storage (Phase 14.3) --------------------------------
# Evidence METADATA lives in PostgreSQL (evidence table). The payload bytes go
# to EVIDENCE_STORAGE_DIR (local dev). Render service filesystems are ephemeral:
# use a production object store (S3) when available; never rely on local disk.
EVIDENCE_STORAGE_DIR=.evidence
EVIDENCE_STORAGE_PROVIDER=filesystem
EVIDENCE_STORAGE_BUCKET=
EVIDENCE_STORAGE_REGION=
EVIDENCE_STORAGE_ENDPOINT=
EVIDENCE_STORAGE_ACCESS_KEY_ID=
EVIDENCE_STORAGE_SECRET_ACCESS_KEY=
EVIDENCE_STORAGE_PREFIX=evidence

# --- Relational database (Phase 14.2) -------------------------------------
# Either set DATABASE_URL directly (Postgres in production, SQLite in tests /
# local verification), OR leave it unset and let the POSTGRES_* components be
# composed into a postgresql+asyncpg:// URL.
#
# A bare postgres:// or postgresql:// connection string (exactly what Render's
# managed DB exposes as its connection string) is normalized at runtime: the
# asyncpg driver is appended for the async engine (database_url) and the bare
# postgresql:// form is used for Alembic's synchronous engine
# (database_url_sync, driven by psycopg2).
#
# Examples:
#   DATABASE_URL=postgresql+asyncpg://trinetra:trinetra_dev_password@localhost:5432/trinetra_pulse
#   DATABASE_URL=postgresql://trinetra:trinetra_dev_password@localhost:5432/trinetra_pulse
#   DATABASE_URL=sqlite+aiosqlite:///./trinetra.db        # ephemeral local dev
DATABASE_URL=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trinetra_pulse
POSTGRES_USER=trinetra
POSTGRES_PASSWORD=trinetra_dev_password

# --- Async engine pool (Phase 17.10) --------------------------------------
# Conservative defaults that fit Render free-tier PostgreSQL connection limits.
# Render overrides these in render.yaml (DB_POOL_SIZE=3, DB_MAX_OVERFLOW=2).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Graph / cache / ML (existing platform services) ----------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# --- Auth (JWT) — Phase 18.1 -----------------------------------------------
# JWT_SECRET_KEY is the signing secret; in APP_ENV=production the API refuses
# to boot with its development default (set a strong random value, e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`; Render generates
# one in render.yaml). Demo accounts are seeded by app/db/seed.py:
#   investigator@trinetra.dev / Investigator!2026
#   supervisor@trinetra.dev   / Supervisor!2026
#   admin@trinetra.dev        / Admin!2026
#   auditor@trinetra.dev      / Auditor!2026   (read-only RBAC role)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI investigation assistant -------------------------------------------
# ai_provider: "mock" (default, deterministic, no external calls) | "openai"
AI_PROVIDER=mock
AI_MODEL=trinetra-deterministic-local-v0
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# --- Provider credential encryption (Phase 23) ------------------------------
# Master secret used to derive (HKDF-SHA256) the AES-256-GCM key that encrypts
# AI/media provider API credentials at rest (app/core/secret_crypto.py).
# Server-side only — never shipped to the client, never committed to git.
# APP_ENV=production refuses to boot without a real value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PROVIDER_ENCRYPTION_KEY=
